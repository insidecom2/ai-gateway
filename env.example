# Copy this file to .env and replace the token with a random value of at least 32 bytes.
# Example: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-secret-at-least-32-bytes
OLLAMA_URL=http://127.0.0.1:11434
PROXY_URL=http://127.0.0.1:8000
GEMINI_API_KEY=
HOST=127.0.0.1
PORT=8000
OLLAMA_TIMEOUT_SECONDS=120

# Optional Turso/libSQL adapter configuration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

MODEL_GEMMA_CELESTIAL = qwen2.5:3b
MODEL_GEMMA_CODE_PRO = qwen2.5:3b
MODEL_GEMMA4_CLOUD = qwen2.5:3b
